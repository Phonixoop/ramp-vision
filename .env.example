# Copy this file to ".env" and fill in real values. This file is committed to
# version control, so never put real secrets in it.
#
# Container configuration lives here too: both compose files read .env via
# `env_file`, so nothing is duplicated in YAML or baked into the image.

# --- Database ---------------------------------------------------------------
# Prisma connection string.
DATABASE_URL="sqlserver://localhost:1433;database=RAMP_Vision;user=sa;password=CHANGE_ME;trustServerCertificate=true;encrypt=true"

# Raw SQL Server connection details (used by the mssql/tedious drivers).
SQL_USER="sa"
SQL_PASSWORD="CHANGE_ME"
SQL_SERVERIP="localhost"
SQL_PORT=1433

# --- NextAuth ---------------------------------------------------------------
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="http://localhost:3000"

# --- Runtime ----------------------------------------------------------------
# Port the server listens on inside the container.
PORT=3000

# Host port published by docker-compose.
APP_PORT=3002

# --- Build ------------------------------------------------------------------
# Skips src/env.mjs validation during a Docker build (set in the Dockerfile's
# builder stage; leave false locally).
DOCKER_BUILD=false
